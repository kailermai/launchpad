{
  "name": "personal-launcher",
  "productName": "PersonalLauncher",
  "version": "0.1.0",
  "description": "A safe, local-first personal launcher for the games and apps you choose to add.",
  "main": "./out/main/index.js",
  "private": true,
  "author": "Kai Ler",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "start": "electron-vite preview",
    "package": "npm run build && electron-builder --win --config electron-builder.yml",
    "smoke": "electron-vite build && electron . --smoke"
  },
  "dependencies": {
    "sql.js": "^1.13.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "^4.5.0",
    "electron": "^37.0.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^4.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0"
  }
}
