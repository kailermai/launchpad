{
  "name": "launchpad",
  "productName": "Launchpad",
  "version": "0.1.0",
  "description": "Launchpad: a safe, local-first shelf for the games and apps you choose to add.",
  "main": "./out/main/index.js",
  "private": true,
  "author": "kailermai",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "start": "electron-vite preview",
    "package": "npm run build && electron-builder --win --config electron-builder.yml",
    "smoke": "electron-vite build && electron . --smoke",
    "package:ci": "electron-builder --win --config electron-builder.yml --publish never"
  },
  "dependencies": {
    "sql.js": "^1.13.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kailermai/launchpad.git"
  },
  "homepage": "https://github.com/kailermai/launchpad#readme",
  "bugs": {
    "url": "https://github.com/kailermai/launchpad/issues"
  }
}
